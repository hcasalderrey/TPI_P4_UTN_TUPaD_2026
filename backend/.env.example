# Copiar este archivo a .env y ajustar los valores.

# PostgreSQL (con el docker-compose.yml de la raíz coincide tal cual).
# Para desarrollo local sin PostgreSQL: sqlite:///./foodstore.db
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

# Firma del JWT: mínimo 32 caracteres. Cambiarla en cualquier entorno real.
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales).
FRONTEND_ORIGIN=http://localhost:5173

# true solo cuando la API se sirve por HTTPS.
COOKIE_SECURE=false
